
<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Écoute & Inspiration au Quotidien</title>
<style>
  /* ============ THEME TOKENS ============ */
  :root {
    --bg: #f4f3ef;
    --surface: #ffffff;
    --surface-2: #edece6;
    --text: #22282b;
    --text-muted: #79807f;
    --accent: #5f8d7d;
    --accent-soft: rgba(95, 141, 125, .13);
    --on-accent: #ffffff;
    --border: rgba(20, 30, 25, .08);
    --shadow: 0 18px 40px -22px rgba(30, 45, 40, .35);
    color-scheme: light;
  }
  [data-theme="dark"] {
    --bg: #0f1214;
    --surface: #181d20;
    --surface-2: #212729;
    --text: #e9ece9;
    --text-muted: #8b9498;
    --accent: #7fb69f;
    --accent-soft: rgba(127, 182, 159, .14);
    --on-accent: #0d1513;
    --border: rgba(255, 255, 255, .07);
    --shadow: 0 18px 40px -22px rgba(0, 0, 0, .85);
    color-scheme: dark;
  }

  /* ============ BASE ============ */
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    transition: background .45s ease, color .45s ease;
  }

  /* halo décoratif */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background:
      radial-gradient(620px 420px at 12% -5%, var(--accent-soft), transparent 70%),
      radial-gradient(520px 420px at 105% 105%, var(--accent-soft), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .app {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
  }

  /* ============ HEADER ============ */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .brand { display: flex; align-items: center; gap: 13px; }
  .logo {
    width: 44px; height: 44px;
    border-radius: 15px;
    display: grid; place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 12px 24px -12px var(--accent);
    flex: 0 0 auto;
  }
  .brand h1 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -.01em;
    font-weight: 700;
  }
  .brand p {
    margin: 2px 0 0;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
  }

  .icon-btn {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    flex: 0 0 auto;
    transition: background .25s ease, color .25s ease, transform .25s ease, border-color .25s;
  }
  .icon-btn:hover {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .icon-btn:active { transform: translateY(0) scale(.96); }

  /* icônes thème */
  .icon-sun { display: none; }
  [data-theme="dark"] .icon-sun { display: block; }
  [data-theme="dark"] .icon-moon { display: none; }

  /* ============ CARDS ============ */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 28px;
    box-shadow: var(--shadow);
    transition: background .45s ease, border-color .45s ease;
  }
  .card + .card { margin-top: 18px; }

  .label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 20px;
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .label::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* ============ CITATION ============ */
  #quoteBox {
    min-height: 128px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity .22s ease, transform .22s ease;
  }
  #quoteBox.is-leaving { opacity: 0; transform: translateY(-10px); }
  #quoteBox.is-entering { animation: quoteIn .55s cubic-bezier(.22, 1, .36, 1); }

  @keyframes quoteIn {
    from { opacity: 0; transform: translateY(16px) scale(.98); }
    to   { opacity: 1; transform: none; }
  }

  .quote-text {
    margin: 0 0 16px;
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-size: clamp(1.25rem, 4.2vw, 1.62rem);
    line-height: 1.45;
    letter-spacing: -.01em;
    font-weight: 400;
  }
  .quote-author {
    margin: 0;
    font-size: .88rem;
    letter-spacing: .04em;
    color: var(--text-muted);
  }

  .actions { display: flex; gap: 10px; margin-top: 26px; }

  .primary-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 15px 20px;
    border: none;
    border-radius: 15px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: inherit;
    font-size: .95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 14px 28px -14px var(--accent);
    transition: transform .2s ease, filter .2s ease, box-shadow .2s ease;
  }
  .primary-btn:hover { filter: brightness(1.07); transform: translateY(-2px); }
  .primary-btn:active { transform: translateY(0) scale(.985); }
  .primary-btn svg { transition: transform .5s cubic-bezier(.22, 1, .36, 1); }
  .primary-btn:hover svg { transform: rotate(180deg); }

  /* ============ SONS ============ */
  .sounds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .sound-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    padding: 20px 10px 16px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    font-family: inherit;
    font-size: .83rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform .25s ease, background .25s ease, border-color .25s ease, color .25s ease, box-shadow .25s ease;
  }
  .sound-btn:hover { transform: translateY(-3px); border-color: var(--accent); }
  .sound-btn:active { transform: translateY(-1px) scale(.98); }
  .sound-btn.active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .s-icon { font-size: 1.55rem; line-height: 1; }

  /* égaliseur animé */
  .bars {
    position: absolute;
    top: 11px; right: 11px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
    opacity: 0;
    transition: opacity .3s ease;
  }
  .sound-btn.active .bars { opacity: 1; }
  .bars i {
    width: 3px; height: 4px;
    border-radius: 2px;
    background: var(--accent);
    animation: eq .9s ease-in-out infinite;
  }
  .bars i:nth-child(2) { animation-delay: .15s; }
  .bars i:nth-child(3) { animation-delay: .32s; }
  @keyframes eq {
    0%, 100% { height: 4px; }
    50%      { height: 14px; }
  }

  /* ============ VOLUME ============ */
  .volume-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .volume-row span {
    font-size: .78rem;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 6px;
    border-radius: 99px;
    background: var(--surface-2);
    outline: none;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    box-shadow: 0 2px 8px -2px var(--accent);
    transition: transform .2s ease;
  }
  input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.18); }
  input[type="range"]::-moz-range-thumb {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    cursor: pointer;
  }

  /* ============ FOOTER + TOAST ============ */
  footer {
    margin-top: 24px;
    text-align: center;
    font-size: .74rem;
    letter-spacing: .05em;
    color: var(--text-muted);
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 30px;
    transform: translate(-50%, 22px);
    padding: 11px 20px;
    border-radius: 99px;
    background: var(--text);
    color: var(--bg);
    font-size: .84rem;
    font-weight: 700;
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s ease, transform .3s ease;
    z-index: 50;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 480px) {
    body { padding: 22px 14px; }
    .card { padding: 20px; border-radius: 20px; }
    .logo { width: 40px; height: 40px; border-radius: 13px; }
    .brand h1 { font-size: .95rem; }
    .sounds { gap: 8px; }
    .sound-btn { padding: 16px 6px 13px; font-size: .74rem; border-radius: 16px; }
    .s-icon { font-size: 1.3rem; }
    #quoteBox { min-height: 140px; }
    .primary-btn { font-size: .88rem; padding: 14px 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important;
      transition-duration: .001ms !important;
    }
  }
</style>
</head>
<body>

<div class="app">

  <!-- ===== HEADER ===== -->
  <header class="topbar">
    <div class="brand">
      <div class="logo">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round">
          <path d="M3 12h2"/><path d="M7.5 8v8"/><path d="M12 4.5v15"/>
          <path d="M16.5 8v8"/><path d="M21 12h-2"/>
        </svg>
      </div>
      <div>
        <h1>Écoute &amp; Inspiration</h1>
        <p>au quotidien</p>
      </div>
    </div>

    <button id="themeToggle" class="icon-btn" aria-label="Basculer le thème sombre / clair">
      <!-- lune (mode clair → passer en sombre) -->
      <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <!-- soleil (mode sombre → passer en clair) -->
      <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.2"/>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
    </button>
  </header>

  <!-- ===== CITATION ===== -->
  <section class="card">
    <p class="label">Inspiration du moment</p>

    <div id="quoteBox" aria-live="polite">
      <p class="quote-text" id="quoteText"></p>
      <p class="quote-author" id="quoteAuthor"></p>
    </div>

    <div class="actions">
      <button id="generateBtn" class="primary-btn">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
          <path d="M21 3v6h-6"/>
        </svg>
        Générer une citation
      </button>

      <button id="copyBtn" class="icon-btn" aria-label="Copier la citation" title="Copier">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="12" height="12" rx="2.5"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
      </button>
    </div>
  </section>

  <!-- ===== SONS D'AMBIANCE ===== -->
  <section class="card">
    <p class="label">Ambiance sonore</p>

    <div class="sounds">
      <button class="sound-btn" data-sound="rain" aria-pressed="false">
        <span class="bars"><i></i><i></i><i></i></span>
        <span class="s-icon">🌧️</span>
        <span>Pluie</span>
      </button>

      <button class="sound-btn" data-sound="lofi" aria-pressed="false">
        <span class="bars"><i></i><i></i><i></i></span>
        <span class="s-icon">🎧</span>
        <span>Lofi</span>
      </button>

      <button class="sound-btn" data-sound="cafe" aria-pressed="false">
        <span class="bars"><i></i><i></i><i></i></span>
        <span class="s-icon">☕</span>
        <span>Café</span>
      </button>
    </div>

    <div class="volume-row">
      <span>🔊 Volume</span>
      <input id="volume" type="range" min="0" max="1" step="0.01" value="0.6"
             aria-label="Volume général">
    </div>
  </section>

  <footer>Écoute &amp; Inspiration au Quotidien — projet IA &amp; Bien-être</footer>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   1. THÈME (clair / sombre)
   ========================================================= */
const root = document.documentElement;
const themeToggle = document.getElementById('themeToggle');

function applyTheme(theme) {
  root.setAttribute('data-theme', theme);
  try { localStorage.setItem('ei-theme', theme); } catch (e) {}
}

(function initTheme() {
  let theme = 'light';
  try {
    const stored = localStorage.getItem('ei-theme');
    theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  } catch (e) {}
  applyTheme(theme);
})();

themeToggle.addEventListener('click', () => {
  applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
});


/* =========================================================
   2. CITATIONS INSPIRANTES
   ========================================================= */
const QUOTES = [
  { t: "Le bonheur n'est pas une destination, c'est une façon de voyager.", a: "Anonyme" },
  { t: "La respiration est le pont entre le corps et l'esprit.", a: "Anonyme" },
  { t: "Ralentir n'est pas perdre du temps, c'est retrouver du sens.", a: "Anonyme" },
  { t: "Prends soin de ton corps : c'est le seul endroit où tu vivras.", a: "Jim Rohn" },
  { t: "Ce n'est pas le quotidien qui est lourd, c'est notre façon de le porter.", a: "Anonyme" },
  { t: "Un esprit calme ne se laisse pas emporter par les tempêtes.", a: "Anonyme" },
  { t: "L'équilibre, ce n'est pas tout tenir, c'est savoir lâcher.", a: "Anonyme" },
  { t: "Chaque jour est une nouvelle chance de recommencer.", a: "Anonyme" },
  { t: "La sérénité commence quand tu acceptes ce que tu ne peux pas changer.", a: "Anonyme" },
  { t: "Écoute ton cœur : il connaît souvent le chemin avant ta raison.", a: "Anonyme" },
  { t: "Ce que tu fais aujourd'hui peut améliorer tous tes lendemains.", a: "Anonyme" },
  { t: "Le silence n'est pas un vide, c'est un espace pour se retrouver.", a: "Anonyme" }
];

const quoteBox    = document.getElementById('quoteBox');
const quoteText   = document.getElementById('quoteText');
const quoteAuthor = document.getElementById('quoteAuthor');
const generateBtn = document.getElementById('generateBtn');
const copyBtn     = document.getElementById('copyBtn');
const toastEl     = document.getElementById('toast');

let lastIndex = -1;

function pickQuote() {
  let i;
  do { i = Math.floor(Math.random() * QUOTES.length); }
  while (i === lastIndex && QUOTES.length > 1);
  lastIndex = i;
  return QUOTES[i];
}

function renderQuote(q) {
  quoteText.textContent = q.t;
  quoteAuthor.textContent = '— ' + q.a;
}

function generateQuote(animate = true) {
  const q = pickQuote();

  if (!animate) { renderQuote(q); return; }

  // sortie en douceur
  quoteBox.classList.add('is-leaving');

  setTimeout(() => {
    renderQuote(q);
    quoteBox.classList.remove('is-leaving');
    quoteBox.classList.remove('is-entering');
    void quoteBox.offsetWidth;          // force le redémarrage de l'animation
    quoteBox.classList.add('is-entering');
  }, 220);
}

generateBtn.addEventListener('click', () => generateQuote(true));
renderQuote(QUOTES[Math.floor(Math.random() * QUOTES.length)]);   // 1re citation, sans animation


/* =========================================================
   3. MOTEUR AUDIO (Web Audio API — 100 % génératif, aucun fichier)
   ========================================================= */
let audioCtx = null;
let masterGain = null;
let noiseBuffer = null;
const activeSounds = {};
const volumeSlider = document.getElementById('volume');

function initAudio() {
  if (audioCtx) {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return;
  }
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();

  masterGain = audioCtx.createGain();
  masterGain.gain.value = parseFloat(volumeSlider.value);
  masterGain.connect(audioCtx.destination);

  // buffer de bruit blanc réutilisable (3 s, en boucle)
  const length = Math.floor(audioCtx.sampleRate * 3);
  noiseBuffer = audioCtx.createBuffer(1, length, audioCtx.sampleRate);
  const data = noiseBuffer.getChannelData(0);
  for (let i = 0; i < length; i++) data[i] = Math.random() * 2 - 1;
}

function noiseSource() {
  const src = audioCtx.createBufferSource();
  src.buffer = noiseBuffer;
  src.loop = true;
  return src;
}

/* ---------- 🌧️ PLUIE ---------- */
function createRain() {
  const out = audioCtx.createGain();
  out.gain.value = 0.0001;
  out.connect(masterGain);

  const src = noiseSource();
  const hp = audioCtx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 600;
  const lp = audioCtx.createBiquadFilter(); lp.type = 'lowpass';  lp.frequency.value = 6800;
  const bed = audioCtx.createGain(); bed.gain.value = 0.30;

  src.connect(hp).connect(lp).connect(bed).connect(out);
  src.start();

  // respiration lente du volume (effet d'averse)
  const lfo = audioCtx.createOscillator(); lfo.frequency.value = 0.08;
  const lfoGain = audioCtx.createGain();   lfoGain.gain.value = 0.09;
  lfo.connect(lfoGain).connect(bed.gain);
  lfo.start();

  // gouttes occasionnelles
  function drop() {
    const t = audioCtx.currentTime;
    const o = audioCtx.createOscillator();
    o.type = 'sine';
    o.frequency.setValueAtTime(900 + Math.random() * 1000, t);
    o.frequency.exponentialRampToValueAtTime(320, t + 0.18);

    const g = audioCtx.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.05, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.26);

    o.connect(g).connect(out);
    o.start(t);
    o.stop(t + 0.3);
  }
  const dropTimer = setInterval(() => { if (Math.random() > 0.55) drop(); }, 850);

  out.gain.linearRampToValueAtTime(1, audioCtx.currentTime + 1.4);

  return {
    stop() {
      clearInterval(dropTimer);
      const t = audioCtx.currentTime;
      out.gain.cancelScheduledValues(t);
      out.gain.setValueAtTime(out.gain.value, t);
      out.gain.linearRampToValueAtTime(0.0001, t + 0.6);
      setTimeout(() => {
        try { src.stop(); lfo.stop(); out.disconnect(); } catch (e) {}
      }, 800);
    }
  };
}

/* ---------- 🎧 LOFI ---------- */
function createLofi() {
  const out = audioCtx.createGain();
  out.gain.value = 0.0001;
  out.connect(masterGain);

  const lp = audioCtx.createBiquadFilter();
  lp.type = 'lowpass'; lp.frequency.value = 1100; lp.Q.value = 0.6;
  lp.connect(out);

  // craquement de vinyle
  const hiss = noiseSource();
  const hp = audioCtx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 2600;
  const hg = audioCtx.createGain(); hg.gain.value = 0.032;
  hiss.connect(hp).connect(hg).connect(out);
  hiss.start();

  // progression d'accords (Am – F – G – C)
  const chords = [
    [220.00, 261.63, 329.63],
    [174.61, 220.00, 261.63],
    [196.00, 246.94, 293.66],
    [130.81, 164.81, 196.00]
  ];
  let index = 0;

  function playChord() {
    const now = audioCtx.currentTime;
    chords[index % chords.length].forEach((freq, i) => {
      const osc = audioCtx.createOscillator();
      osc.type = i === 0 ? 'sine' : 'triangle';
      osc.frequency.value = freq;

      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.0001, now);
      g.gain.linearRampToValueAtTime(0.075, now + 1.4);
      g.gain.linearRampToValueAtTime(0.0001, now + 5.6);

      osc.connect(g).connect(lp);
      osc.start(now);
      osc.stop(now + 5.8);
    });
    index++;
  }

  playChord();
  const chordTimer = setInterval(playChord, 5200);

  out.gain.linearRampToValueAtTime(0.85, audioCtx.currentTime + 1.4);

  return {
    stop() {
      clearInterval(chordTimer);
      const t = audioCtx.currentTime;
      out.gain.cancelScheduledValues(t);
      out.gain.setValueAtTime(out.gain.value, t);
      out.gain.linearRampToValueAtTime(0.0001, t + 0.6);
      setTimeout(() => {
        try { hiss.stop(); out.disconnect(); } catch (e) {}
      }, 800);
    }
  };
}

/* ---------- ☕ CAFÉ ---------- */
function createCafe() {
  const out = audioCtx.createGain();
  out.gain.value = 0.0001;
  out.connect(masterGain);

  // rumeur sourde de la salle
  const base = noiseSource();
  const lp = audioCtx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 520;
  const bg = audioCtx.createGain(); bg.gain.value = 0.5;
  base.connect(lp).connect(bg).connect(out);
  base.start();

  // conversations (bande passante modulée)
  const murmur = noiseSource();
  const bp = audioCtx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 800; bp.Q.value = 0.8;
  const mg = audioCtx.createGain(); mg.gain.value = 0.12;
  murmur.connect(bp).connect(mg).connect(out);
  murmur.start();

  const lfo = audioCtx.createOscillator(); lfo.frequency.value = 0.33;
  const lg = audioCtx.createGain();   lg.gain.value = 0.07;
  lfo.connect(lg).connect(mg.gain);
  lfo.start();

  // tintements de tasses
  function clink() {
    const t = audioCtx.currentTime;
    [1850, 2400, 3150].forEach((f, i) => {
      const o = audioCtx.createOscillator();
      o.type = 'sine';
      o.frequency.value = f * (0.95 + Math.random() * 0.1);

      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.linearRampToValueAtTime(0.018 / (i + 1), t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);

      o.connect(g).connect(out);
      o.start(t);
      o.stop(t + 0.7);
    });
  }
  const clinkTimer = setInterval(() => { if (Math.random() < 0.55) clink(); }, 3400);

  out.gain.linearRampToValueAtTime(0.9, audioCtx.currentTime + 1.4);

  return {
    stop() {
      clearInterval(clinkTimer);
      const t = audioCtx.currentTime;
      out.gain.cancelScheduledValues(t);
      out.gain.setValueAtTime(out.gain.value, t);
      out.gain.linearRampToValueAtTime(0.0001, t + 0.6);
      setTimeout(() => {
        try { base.stop(); murmur.stop(); lfo.stop(); out.disconnect(); } catch (e) {}
      }, 800);
    }
  };
}

/* ---------- CONTRÔLES ---------- */
const BUILDERS = { rain: createRain, lofi: createLofi, cafe: createCafe };

document.querySelectorAll('.sound-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const name = btn.dataset.sound;
    initAudio();

    if (activeSounds[name]) {
      activeSounds[name].stop();
      delete activeSounds[name];
      btn.classList.remove('active');
      btn.setAttribute('aria-pressed', 'false');
    } else {
      activeSounds[name] = BUILDERS[name]();
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    }
  });
});

volumeSlider.addEventListener('input', () => {
  if (!masterGain || !audioCtx) return;
  masterGain.gain.setTargetAtTime(parseFloat(volumeSlider.value), audioCtx.currentTime, 0.05);
});


/* =========================================================
   4. TOAST + COPIE
   ========================================================= */
let toastTimer;
function showToast(message) {
  toastEl.textContent = message;
  toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1800);
}

copyBtn.addEventListener('click', async () => {
  const text = `${quoteText.textContent} ${quoteAuthor.textContent}`;
  try {
    await navigator.clipboard.writeText(text);
    showToast('Citation copiée ✓');
  } catch (e) {
    showToast('Copie impossible');
  }
});
